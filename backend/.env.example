# Every value below already has a working default in app/config/config.yaml,
# except the secrets (OPENROUTER_API_KEY, the SUPABASE_* keys) which are null
# there and MUST be set here for anything that talks to an LLM or Supabase to
# work. Anything you leave blank falls back to config.yaml.
#
# NOTE on ENV: get_settings() (app/config/settings.py) reads ENV via a raw
# os.getenv('ENV', 'LOCAL') call at import time, before pydantic-settings has
# loaded this file — so for a non-Docker local run (`uv run uvicorn ...`) you
# need to `export ENV=LOCAL` (or DEV/PROD) in your shell, not just set it
# here. docker-compose.dev.yaml already sets it directly for the Docker path.

# ── Core app ────────────────────────────────────────────────────────────
API_PREFIX=/api/v1
API_VERSION=v1.1.9
ENV=LOCAL                      # LOCAL | DEV | PROD (see note above)
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:3000

# ── Logging ─────────────────────────────────────────────────────────────
LOGURU_LEVEL=DEBUG
LOGURU_FORMAT=<green>{time:YYYY-MM-DD HH:mm:ss.SSS}</green> | <level>{level: <8}</level> | <cyan>{name}</cyan>:<cyan>{function}</cyan>:<cyan>{line}</cyan> - <level>{message}</level>

# ── Retries / uploads ───────────────────────────────────────────────────
BASE_DELAY=1                   # seconds, retry backoff base
MAX_ATTEMPTS=5
MAX_FILE_SIZE=25                # MB
MAX_PART_SIZE=5                 # MB
SPOOL_MAX_SIZE=50               # MB

# ── Rate limiting & shared-key daily quota ──────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=5
DAILY_FREE_LIMIT=5              # per-user daily cap when using the shared OpenRouter key
DEFAULT_FREE_MODEL=qwen/qwen2.5-vl-72b-instruct:free
FREE_MODELS=qwen/qwen2.5-vl-72b-instruct:free   # comma-separated allowlist

# ── OpenRouter (LLM ticket extraction) ───────────────────────────────────
OPENROUTER_API_KEY=

# ── Google Places (theatre autocomplete/details) ─────────────────────────
# Optional — theatre creation still works without it (falls back to
# free-typed data, source='user_submitted'). Restrict this key to the
# Places API (New) only; it's called server-side (services/google_places.py),
# never sent to the client.
GOOGLE_PLACES_API_KEY=

# ── TMDB (movie search/autocomplete, upcoming releases) ───────────────────
# Optional — free at https://www.themoviedb.org/settings/api. Use the "API
# Read Access Token" (v4 auth, a long JWT starting "eyJ...") — sent as
# Authorization: Bearer, see services/tmdb.py. The separate "API Key" (v3
# auth, a short 32-char hex string) shown on the same page is a different
# credential and will NOT work here, since that one requires a ?api_key=
# query param instead. Without this set, a movie log still works with just
# a free-typed title (movie_id/catalog features are unavailable until it
# is set, same fallback shape as Google Places above).
TMDB_API_KEY=

# ── Supabase ──────────────────────────────────────────────────────────────
# Project URL + publishable/anon key. The publishable key is sent as the
# `apikey` header on every PostgREST call made with the caller's own access
# token (RLS still does the actual authorization).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Privileged key, used server-side ONLY for the daily-quota RPC
# (services/quota.py) — never forwarded to clients. Use your project's
# secret key; SUPABASE_SERVICE_ROLE_KEY is the legacy name and is only read
# as a fallback if SUPABASE_SECRET_KEY is unset.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Legacy HS256 JWT secret. If set, it's tried first; on failure (or if unset)
# verification falls back to JWKS. Newer Supabase projects sign with JWKS by
# default, so leave this unset unless you know your project uses HS256 —
# see auth/supabase_auth.py.
SUPABASE_JWT_SECRET=

# ── Local/dev only ───────────────────────────────────────────────────────
# Skips JWT verification and returns a fixed dev user (00000000-0000-0000-
# 0000-000000000001) when no bearer token is sent. Only honored when ENV is
# LOCAL or DEV (see auth/supabase_auth.py). NEVER set true in PROD.
DEV_BYPASS_AUTH=false

# ── Admin ─────────────────────────────────────────────────────────────────
# Comma-separated Supabase user_ids allowed through get_current_admin
# (auth/supabase_auth.py) — a flat allowlist, not a role/RBAC system. Empty
# by default: every admin-only route (report triage) 403s for everyone
# until this is set.
ADMIN_USER_IDS=
