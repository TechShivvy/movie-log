# syntax=docker/dockerfile:1.4

########################################
# Base image: minimal Debian with Python
FROM python:3.11.15-slim-bookworm AS base

RUN : \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        net-tools \
        tini \
        libmagic1 \
        libmagic-dev \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* \
    && :

# Chromium's OS-level shared libraries (libnss3, libgbm1, fonts, ...) for
# headless-browser ticket-link extraction (services/ticket_link_extractor.py).
# `playwright install-deps` is Playwright's own maintained resolver for
# these package names/versions across Debian releases — far more robust
# than hand-listing them here, since exact package names shift between
# Debian versions. This is a throwaway system-level playwright install
# used only to run that one command; the actual browser binary + the
# playwright Python package the app imports both come from the project's
# own .venv in the builder stage below, landing in a directory
# (PLAYWRIGHT_BROWSERS_PATH) that gets copied into the runtime image.
RUN : \
    && pip install --no-cache-dir --quiet playwright \
    && playwright install-deps chromium \
    && pip uninstall -y --quiet playwright \
    && :

ENV PLAYWRIGHT_BROWSERS_PATH=/opt/src/pw-browsers

########################################
# Builder stage: install uv, dependencies, and project code
FROM base AS builder

COPY --from=ghcr.io/astral-sh/uv:0.7.21 /uv /usr/local/bin/

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /opt/src/app

COPY pyproject.toml uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --no-install-project --no-dev --no-editable

COPY app/ ./
COPY scripts/docker-entry.sh ./

RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --no-dev --no-editable

# Downloads the actual Chromium browser binary (distinct from the apt
# libs above, which are OS-level) into PLAYWRIGHT_BROWSERS_PATH, a
# sibling of app/ under /opt/src so the runtime stage's
# `COPY --from=builder /opt/src /opt/src` below picks it up too.
RUN uv run --no-dev playwright install chromium

########################################
# Runtime stage: minimal container run environment
FROM base AS runtime

RUN useradd --system --create-home --shell /bin/bash appuser

COPY --from=builder --chown=appuser:appuser /opt/src /opt/src

USER appuser
WORKDIR /opt/src/app
ENV PATH="/opt/src/app/.venv/bin:$PATH"

EXPOSE 8080

RUN chmod +x docker-entry.sh
ENTRYPOINT ["/usr/bin/tini", "--", "./docker-entry.sh"]
CMD []
